# Copy this file to `.env` and fill in your personal values.
# `.env` is gitignored — never commit it.
#
# Loaded by `mjlab_project._envfile` before any `import wandb`, so the global
# `~/.netrc` and global wandb login are NOT modified.

# From https://wandb.ai/authorize
WANDB_API_KEY=

# Your personal wandb username or team slug.
WANDB_ENTITY=

# Optional: default project name if `tracker.wandb.project` is not set on CLI.
# WANDB_PROJECT=mjlab_project
